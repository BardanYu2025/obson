  "findings": [
    {
      "id": "F1",
      "status": "confirmed_design_limitation",
      "finding": "Only remote ages17+ receive the additional structure loss; local diagnostic head is detached from encoder in multiple stages. Not an implementation accident, but cannot be described as a symmetric near/far encoder objective.",
      "evidence": [
        "history_structure.py:metrics,losses",
        "causal_pool.py:losses",
        "activity_weight.py:losses",
        "shared_history.py:losses",
        "uniform_context.py:loss_rows"
      ]
    },
    {
      "id": "F2",
      "status": "confirmed_implicit_reweighting",
      "finding": "Changing prefix availability changes band averaging; full-context training mixes added input history, expanded labels and changed effective age weights. It does not isolate input length alone.",
      "expected_band_shares_prefix": [
        0.3806451612903227,
        0.3806451612903227,
        0.23870967741935478
      ],
      "expected_band_shares_full": [
        0.3333333333333333,
        0.3333333333333333,
        0.3333333333333333
      ],
      "evidence": [
        "history_query.py:metrics,sample_prefixes",
        "uniform_context.py:targets"
      ]
    },
    {
      "id": "F3",
      "status": "confirmed_recent_recipe_discontinuity_not_universal_bug",
      "finding": "Context Transfer resets optimizer and uses fixed peak LR immediately. Earlier audited warm stages have warmup/cosine; optimizer reset alone is not automatically invalid when matched across arms. No evidence here establishes high LR as the unique cause.",
      "source_epoch_to_restart_lr_ratio": {
        "s42": 9.78352064002057,
        "s43": 9.188725972809072
      },
      "evidence": [
        "context_transfer_run.py:worker,train_epoch",
        "capacity_growth.py:learning_rate",
        "macro_history_run.py:rates",
        "recorded archived histories"
      ]
    },
    {
      "id": "F4",
      "status": "previously_confirmed_objective_identifiability_gap",
      "finding": "Shared History free auxiliary task admits query-independent noncollapsed solutions. The existing constructive counterexample limits semantic claims, not proof that real trained weights used that shortcut.",
      "evidence": [
        "docs/BABEL_SHARED_HISTORY_DESIGN_AUDIT.md",
        "shared_history.py"
      ]
    },
    {
      "id": "F5",
      "status": "limited_causal_scope",
      "finding": "Depth equal100 comparisons retain recipe-level evidence; extended4-layer191/281 add updates, exposure, LR restarts and validation opportunities. Cannot infer4layers globally optimal.",
      "evidence": [
        "depth_scaling_run.py:learning_rates",
        "docs/BABEL_DEPTH768_REVIEW.md"
      ]
    },
    {
      "id": "F6",
      "status": "limited_scope_across_all_reviewed_reports",
      "finding": "Repeated research cohorts, warm starts, epoch0 fallbacks and decoder/encoder co-adaptation limit generalization and information-loss claims. Report arithmetic verification does not establish causal interpretation or independent replication.",
      "evidence": [
        "docs/BABEL_ACTIVITY_WEIGHT768_REVIEW.md",
        "docs/BABEL_POSITION_SUPERVISION768_REVIEW.md",
        "docs/BABEL_CONTEXT_TRANSFER768_REVIEW.md"
      ]
    }
  ],
